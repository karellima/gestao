# O Docker Compose local usa estas credenciais de desenvolvimento.
DATABASE_URL=postgresql://gestao:gestao@localhost:5432/gestao

# Gere uma chave secreta: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bootstrap do administrador inicial (opcional).
# Defina ambas para que o primeiro admin seja criado automaticamente
# quando o banco estiver vazio. Sem elas o banco nasce sem usuários.
# ADMIN_NAME=Administrador
# ADMIN_EMAIL=admin@exemplo.com
# ADMIN_PASSWORD=senha-segura
