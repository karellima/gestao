# Copie para .env.homologacao no host de homologacao e chmod 600.
# Use aqui a mesma tag imutavel de APP_IMAGE que esta em producao.
APP_IMAGE=ghcr.io/karellima/gestao:main
HOMOLOGACAO_APP_PORT=8001
POSTGRES_DB=gestao_homologacao
POSTGRES_USER=gestao_homologacao
POSTGRES_PASSWORD=change-this-homologacao-password
DATABASE_URL=postgresql://gestao_homologacao:change-this-homologacao-password@db:5432/gestao_homologacao
SECRET_KEY=generate-a-different-homologacao-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# O seed cria os perfis, categorias, unidades e depositos de demonstracao.
# Estas credenciais criam o administrador de teste no primeiro boot.
ADMIN_NAME=Administrador de homologacao
ADMIN_EMAIL=admin@homologacao.local
ADMIN_PASSWORD=change-this-homologacao-admin-password
RUN_MIGRATIONS=1
