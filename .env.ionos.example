# Copy to /opt/gestao/.env.ionos on the IONOS host and chmod 600 it.
APP_IMAGE=ghcr.io/karellima/gestao:main
# A porta 8000 do host IONOS pertence ao Portainer. O app continua ouvindo em
# 8000 dentro do container e fica disponível localmente no host pela 8001.
APP_PORT=8001
POSTGRES_DB=gestao
POSTGRES_USER=gestao
POSTGRES_PASSWORD=change-this-long-random-password
DATABASE_URL=postgresql://gestao:change-this-long-random-password@db:5432/gestao
SECRET_KEY=generate-a-64-character-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Obrigatorio em producao: o dominio pelo qual o sistema e acessado. O default do
# app cobre so o desenvolvimento local, entao sem esta linha o navegador recusa
# as chamadas da API. Varias origens vao separadas por virgula, sem barra no fim.
CORS_ORIGINS=https://gestao.seu-dominio.com.br
# Administrador inicial. So e criado quando o banco esta sem usuarios. Depois da
# primeira subida, apague estas duas linhas do arquivo no servidor.
ADMIN_EMAIL=
ADMIN_PASSWORD=
RUN_MIGRATIONS=1
BACKUP_DIR=/var/backups/gestao
RETENTION_DAYS=14
